         :generate_multiple_pod_projects => true,
         :incremental_installation => true

target 'TuneURL' do
    pod 'Alamofire', '~> 4.9.0'
    pod 'DMSwipeCards'
end

target 'TuneURL (SDK)' do
    pod 'Alamofire', '~> 4.9.0'
end
